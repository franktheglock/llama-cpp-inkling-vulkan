#version 450

#include "dequant_head.glsl"

// 256 threads per workgroup, each thread fully dequants one TQ2_0 block
// (256 elements, 64 bytes + fp16 scale). Element order matches
// dequantize_row_tq2_0 in ggml/src/ggml-quants.c.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// NOTE: block_tq2_0 comes from types.glsl (unconditional struct).

layout (binding = 0) readonly buffer A { block_tq2_0 data_a[]; };
layout (binding = 1) writeonly buffer D { D_TYPE data_b[]; };

void main() {
    const uint ib = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (ib >= p.nel / 256u) return;

    const float d = float(data_a[ib].d);

    const uint out_base = ib * 256u;
    for (uint j = 0u; j < 64u; j += 32u) {
        for (uint l = 0u; l < 4u; ++l) {
            for (uint m = 0u; m < 32u; ++m) {
                const uint q = (uint(data_a[ib].qs[j + m]) >> (l * 2u)) & 3u;
                data_b[out_base + (j / 32u) * 128u + l * 32u + m] = D_TYPE((float(q) - 1.0) * d);
            }
        }
    }
}
