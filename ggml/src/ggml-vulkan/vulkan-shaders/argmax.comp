#version 450

#include "generic_head.glsl"
#include "types.glsl"

#extension GL_EXT_control_flow_attributes : enable

#define FLT_MAX 3.402823466e+38F

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};

layout (constant_id = 0) const uint BLOCK_SIZE = 32;

shared FLOAT_TYPE tmpmax[BLOCK_SIZE];
shared uint tmp[BLOCK_SIZE];

void main() {
    const uint row = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x;
    const uint col = gl_LocalInvocationID.x;

    if (row >= p.KY) {
        return;
    }

    const uint base = row * p.KX;
    FLOAT_TYPE amax = -FLT_MAX;
    uint acol = col;

    if (col < p.KX) {
        amax = FLOAT_TYPE(data_a[base + col]);
    }

    uint i = col + BLOCK_SIZE;
    const uint stride4 = BLOCK_SIZE * 4u;
    for (; i + BLOCK_SIZE * 3u < p.KX; i += stride4) {
        const FLOAT_TYPE v0 = FLOAT_TYPE(data_a[base + i]);
        const FLOAT_TYPE v1 = FLOAT_TYPE(data_a[base + i + BLOCK_SIZE]);
        const FLOAT_TYPE v2 = FLOAT_TYPE(data_a[base + i + BLOCK_SIZE * 2u]);
        const FLOAT_TYPE v3 = FLOAT_TYPE(data_a[base + i + BLOCK_SIZE * 3u]);
        if (v0 > amax) { amax = v0; acol = i; }
        if (v1 > amax) { amax = v1; acol = i + BLOCK_SIZE; }
        if (v2 > amax) { amax = v2; acol = i + BLOCK_SIZE * 2u; }
        if (v3 > amax) { amax = v3; acol = i + BLOCK_SIZE * 3u; }
    }
    for (; i < p.KX; i += BLOCK_SIZE) {
        const FLOAT_TYPE val = FLOAT_TYPE(data_a[base + i]);
        if (val > amax) {
            amax = val;
            acol = i;
        }
    }

    tmp[col] = acol;
    tmpmax[col] = amax;

    barrier();
    [[unroll]] for (int s = int(BLOCK_SIZE) / 2; s > 0; s >>= 1) {
        if (col < s && col + s < p.KX) {
            const FLOAT_TYPE bmax = tmpmax[col + s];
            const uint bcol = tmp[col + s];
            if (tmpmax[col] < bmax || (tmpmax[col] == bmax && bcol < tmp[col])) {
                tmpmax[col] = bmax;
                tmp[col] = bcol;
            }
        }
        barrier();
    }

    if (col == 0) {
        data_d[row] = D_TYPE(tmp[0]);
    }
}
