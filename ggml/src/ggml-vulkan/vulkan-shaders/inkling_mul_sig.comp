#version 450

// Fused a * sigmoid(b) elementwise for Inkling 2 attention output gating.

layout (push_constant) uniform parameter { uint n; } p;

layout (binding = 0) readonly  buffer A {float data_a[];};
layout (binding = 1) readonly  buffer B {float data_b[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint i = gl_WorkGroupID.y * 65535u * 256u + gl_GlobalInvocationID.x;
    if (i < p.n) {
        data_d[i] = data_a[i] / (1.0 + exp(-data_b[i]));
    }
}
