#version 450

// Fused Inkling 2 MoE down projection + per-expert scale + routing weights + expert sum for Q8_0 weights.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#define DATA_A_Q8_0
#include "types.glsl"

layout (push_constant) uniform parameter {
    uint ncols;             // K = n_ff, multiple of 32
    uint nrows;             // M = n_embd
    uint blocks_per_expert; // (K/32) * M
    uint n_used;
    uint T;
    uint ids_nb1;
    uint has_scale;
} p;

layout (binding = 0) readonly  buffer A16 {block_q8_0_packed16 data_a16[];};
layout (binding = 1) readonly  buffer X4  {vec4  data_x4[];};
layout (binding = 2) readonly  buffer IDS {int   data_ids[];};
layout (binding = 3) readonly  buffer W   {float data_w[];};
layout (binding = 4) readonly  buffer SC  {float data_sc[];};
layout (binding = 5) writeonly buffer D   {float data_d[];};

layout (constant_id = 0) const uint BLOCK_SIZE = 32;
layout (constant_id = 1) const uint NUM_ROWS = 2;

layout (local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

float q8_half_dot(const uint ib, const uint half_id, const vec4 x0, const vec4 x1, const vec4 x2, const vec4 x3) {
    const float d = float(data_a16[ib].d);
    const uint q0 = half_id * 8u;
    const int u0 = int(pack32(i16vec2(data_a16[ib].qs[q0    ], data_a16[ib].qs[q0 + 1u])));
    const int u1 = int(pack32(i16vec2(data_a16[ib].qs[q0 + 2u], data_a16[ib].qs[q0 + 3u])));
    const int u2 = int(pack32(i16vec2(data_a16[ib].qs[q0 + 4u], data_a16[ib].qs[q0 + 5u])));
    const int u3 = int(pack32(i16vec2(data_a16[ib].qs[q0 + 6u], data_a16[ib].qs[q0 + 7u])));

    const float s =
        dot(x0, vec4(float(bitfieldExtract(u0, 0, 8)), float(bitfieldExtract(u0, 8, 8)), float(bitfieldExtract(u0, 16, 8)), float(bitfieldExtract(u0, 24, 8)))) +
        dot(x1, vec4(float(bitfieldExtract(u1, 0, 8)), float(bitfieldExtract(u1, 8, 8)), float(bitfieldExtract(u1, 16, 8)), float(bitfieldExtract(u1, 24, 8)))) +
        dot(x2, vec4(float(bitfieldExtract(u2, 0, 8)), float(bitfieldExtract(u2, 8, 8)), float(bitfieldExtract(u2, 16, 8)), float(bitfieldExtract(u2, 24, 8)))) +
        dot(x3, vec4(float(bitfieldExtract(u3, 0, 8)), float(bitfieldExtract(u3, 8, 8)), float(bitfieldExtract(u3, 16, 8)), float(bitfieldExtract(u3, 24, 8))));
    return s * d;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    if (first_row >= p.nrows) {
        return;
    }
    const uint t = gl_WorkGroupID.z;

    const uint nb = p.ncols >> 5; // K / 32
    const uint half_id = tid & 1u;
    const uint blk_lane = tid >> 1u;
    const uint blk_stride = BLOCK_SIZE >> 1u;
    const uint k4 = p.ncols >> 2u;

    float acc[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        acc[n] = 0.0;
    }

    for (uint e = 0u; e < p.n_used; ++e) {
        const uint expert = uint(data_ids[t * p.ids_nb1 + e]);
        float we = data_w[t * p.n_used + e];
        if (p.has_scale != 0u) {
            we *= data_sc[expert];
        }
        const uint x_base4 = (t * p.n_used + e) * k4;
        const uint exp_base = expert * p.blocks_per_expert;

        float te[NUM_ROWS];
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            te[n] = 0.0;
        }
        for (uint b = blk_lane; b < nb; b += blk_stride) {
            const uint xb4 = x_base4 + b * 8u + half_id * 4u;
            const vec4 x0 = data_x4[xb4];
            const vec4 x1 = data_x4[xb4 + 1u];
            const vec4 x2 = data_x4[xb4 + 2u];
            const vec4 x3 = data_x4[xb4 + 3u];

            [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                const uint row = min(first_row + n, p.nrows - 1u);
                te[n] += q8_half_dot(exp_base + row * nb + b, half_id, x0, x1, x2, x3);
            }
        }
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            acc[n] = fma(we, te[n], acc[n]);
        }
    }

    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        acc[n] = subgroupAdd(acc[n]);
    }

    if (tid == 0u) {
        const uint out_base = t * p.nrows;
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint row = first_row + n;
            if (row < p.nrows) {
                data_d[out_base + row] = acc[n];
            }
        }
    }
}
