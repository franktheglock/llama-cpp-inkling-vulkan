#version 450

// Inkling 2 depth mix: for token t, states s = blocks[0..n_blocks-1], cur, each rms-normalized;
// p[s,q] = softmax_s(dot(norm(state_s), query_q)/sqrt(n_embd)); out[:, t, q] = sum_s p[s,q]*norm(state_s).
// One 1024-thread workgroup per token, each thread owns up to E_PER elements; every loop has a compile-time
// trip count and is unrolled, so all state loads are in flight together (one memory latency, not one per element).

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#define S_MAX 9
#define Q_MAX 4
#define E_PER 5
#define WG 512
#define NV (S_MAX*(Q_MAX + 1))

layout (push_constant) uniform parameter {
    uint n_embd; uint T; uint nq; uint n_blocks; uint q_stride; uint chunk; float eps;
} p;

layout (binding = 0)  readonly  buffer Q   {float data_q[];};
layout (binding = 1)  readonly  buffer C   {float data_c[];};
layout (binding = 2)  readonly  buffer B0  {float data_b0[];};
layout (binding = 3)  readonly  buffer B1  {float data_b1[];};
layout (binding = 4)  readonly  buffer B2  {float data_b2[];};
layout (binding = 5)  readonly  buffer B3  {float data_b3[];};
layout (binding = 6)  readonly  buffer B4  {float data_b4[];};
layout (binding = 7)  readonly  buffer B5  {float data_b5[];};
layout (binding = 8)  readonly  buffer B6  {float data_b6[];};
layout (binding = 9)  readonly  buffer B7  {float data_b7[];};
layout (binding = 10) writeonly buffer D   {float data_d[];};

layout (local_size_x = WG, local_size_y = 1, local_size_z = 1) in;

shared float red[WG/8][NV];
shared vec4  wsh[S_MAX];

float load_state(uint s, uint idx) {
    // s is a compile-time constant at every call site (unrolled loops)
    if (s == p.n_blocks) { return data_c[idx]; }
    if (s == 0) { return data_b0[idx]; }
    if (s == 1) { return data_b1[idx]; }
    if (s == 2) { return data_b2[idx]; }
    if (s == 3) { return data_b3[idx]; }
    if (s == 4) { return data_b4[idx]; }
    if (s == 5) { return data_b5[idx]; }
    if (s == 6) { return data_b6[idx]; }
    return data_b7[idx];
}

void main() {
    const uint t = gl_WorkGroupID.x + gl_WorkGroupID.y*65535;
    if (t >= p.T) {
        return;
    }
    const uint tid  = gl_LocalInvocationID.x;
    const uint n_st = p.n_blocks + 1;
    const uint base = t*p.n_embd;

    float sv[S_MAX][E_PER];
    vec4  qv[E_PER];
    [[unroll]] for (uint k = 0; k < E_PER; ++k) {
        const uint e = tid + k*WG;
        const bool ok = e < p.n_embd;
        qv[k] = vec4(ok && p.nq > 0 ? data_q[e] : 0.0,
                     ok && p.nq > 1 ? data_q[p.q_stride + e] : 0.0,
                     ok && p.nq > 2 ? data_q[2*p.q_stride + e] : 0.0,
                     ok && p.nq > 3 ? data_q[3*p.q_stride + e] : 0.0);
        [[unroll]] for (uint s = 0; s < S_MAX; ++s) {
            sv[s][k] = (ok && s < n_st) ? load_state(s, base + e) : 0.0;
        }
    }

    const uint sg = gl_SubgroupID;
    [[unroll]] for (uint s = 0; s < S_MAX; ++s) {
        float ss = 0.0;
        vec4  dq = vec4(0.0);
        [[unroll]] for (uint k = 0; k < E_PER; ++k) {
            ss += sv[s][k]*sv[s][k];
            dq += sv[s][k]*qv[k];
        }
        ss = subgroupAdd(ss);
        dq = subgroupAdd(dq);
        if (gl_SubgroupInvocationID == 0) {
            red[sg][s*(Q_MAX + 1) + 0] = ss;
            red[sg][s*(Q_MAX + 1) + 1] = dq.x;
            red[sg][s*(Q_MAX + 1) + 2] = dq.y;
            red[sg][s*(Q_MAX + 1) + 3] = dq.z;
            red[sg][s*(Q_MAX + 1) + 4] = dq.w;
        }
    }
    barrier();

    // fold the subgroup partials: thread i < NV sums column i
    if (tid < NV) {
        float a = 0.0;
        for (uint g = 0; g < gl_NumSubgroups; ++g) {
            a += red[g][tid];
        }
        red[0][tid] = a;
    }
    barrier();

    if (tid == 0) {
        const float kscale = inversesqrt(float(p.n_embd));
        float rinv[S_MAX];
        vec4  w[S_MAX];
        vec4  mx = vec4(-1.0/0.0);
        [[unroll]] for (uint s = 0; s < S_MAX; ++s) {
            rinv[s] = inversesqrt(red[0][s*(Q_MAX + 1)]/float(p.n_embd) + p.eps);
            w[s] = vec4(red[0][s*(Q_MAX + 1) + 1], red[0][s*(Q_MAX + 1) + 2], red[0][s*(Q_MAX + 1) + 3], red[0][s*(Q_MAX + 1) + 4])*(rinv[s]*kscale);
            if (s < n_st) { mx = max(mx, w[s]); }
        }
        vec4 sum = vec4(0.0);
        [[unroll]] for (uint s = 0; s < S_MAX; ++s) {
            w[s] = s < n_st ? exp(w[s] - mx) : vec4(0.0);
            sum += w[s];
        }
        [[unroll]] for (uint s = 0; s < S_MAX; ++s) {
            wsh[s] = w[s]/sum*rinv[s];
        }
    }
    barrier();

    const uint q_step = p.T*p.n_embd;
    [[unroll]] for (uint k = 0; k < E_PER; ++k) {
        const uint e = tid + k*WG;
        if (e < p.n_embd) {
            vec4 acc = vec4(0.0);
            [[unroll]] for (uint s = 0; s < S_MAX; ++s) {
                acc += wsh[s]*sv[s][k];
            }
            const uint o = base + e;
            data_d[o] = acc.x;
            if (p.nq > 1) { data_d[o + q_step]   = acc.y; }
            if (p.nq > 2) { data_d[o + 2*q_step] = acc.z; }
            if (p.nq > 3) { data_d[o + 3*q_step] = acc.w; }
        }
    }
}
