#version 450

// Inkling 2 short conv: y[c, t] = (x[c, t + K-1] + sum_k w[k, c]*x[c, t + k] + sum_lag dyn[lag, h(c), t]*x[c, t + K-1 - lag]) * out_scale
// x: [K-1 + n_t, C, n_s] (row stride x_nb1 floats, seq stride x_nb2 floats), w: [K, C], dyn: [K*H, T]

#extension GL_EXT_control_flow_attributes : enable

layout (push_constant) uniform parameter {
    uint C; uint K; uint n_t; uint n_s; uint x_nb1; uint x_nb2; uint H; float out_scale;
} p;

layout (binding = 0) readonly  buffer X   {float data_x[];};
layout (binding = 1) readonly  buffer W   {float data_w[];};
layout (binding = 2) readonly  buffer DYN {float data_dyn[];};
layout (binding = 3) writeonly buffer D   {float data_d[];};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint c  = gl_GlobalInvocationID.x;
    const uint tg = gl_WorkGroupID.y + gl_WorkGroupID.z*65535;
    if (c >= p.C || tg >= p.n_t*p.n_s) {
        return;
    }
    const uint s = tg/p.n_t;
    const uint t = tg%p.n_t;
    const uint xb = c*p.x_nb1 + s*p.x_nb2 + t;

    float acc = data_x[xb + p.K - 1];
    for (uint k = 0; k < p.K; ++k) {
        acc += data_w[c*p.K + k]*data_x[xb + k];
    }
    if (p.H != 0) {
        const uint h  = c/(p.C/p.H);
        const uint db = tg*p.K*p.H + h*p.K;
        for (uint lag = 0; lag < p.K; ++lag) {
            acc += data_dyn[db + lag]*data_x[xb + p.K - 1 - lag];
        }
    }
    data_d[tg*p.C + c] = acc*p.out_scale;
}
