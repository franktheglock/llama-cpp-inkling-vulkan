#version 450

// Inkling 2 loop controller: y = (1 - tanh(f))*cur + tanh(g)*msg

layout (push_constant) uniform parameter { uint n; } p;

layout (binding = 0) readonly  buffer CUR {float data_cur[];};
layout (binding = 1) readonly  buffer MSG {float data_msg[];};
layout (binding = 2) readonly  buffer F   {float data_f[];};
layout (binding = 3) readonly  buffer G   {float data_g[];};
layout (binding = 4) writeonly buffer D   {float data_d[];};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint i = gl_GlobalInvocationID.y*65535*256 + gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    data_d[i] = (1.0 - tanh(data_f[i]))*data_cur[i] + tanh(data_g[i])*data_msg[i];
}
