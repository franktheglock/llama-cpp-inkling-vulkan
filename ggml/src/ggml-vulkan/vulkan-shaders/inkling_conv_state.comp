#version 450

// Inkling 2 short conv reading history and input directly, writing new conv state
// (including optional n_rs_seq rollback snapshot slots), with optional fused residual addition.

#extension GL_EXT_control_flow_attributes : enable

layout (push_constant) uniform parameter {
    uint C; uint K; uint n_t; uint n_s; uint p_nb1; uint p_nb2; uint H; uint s_row; uint has_state; float out_scale; uint has_resid; uint n_rs_slots; uint s_slot_stride;
} p;

layout (binding = 0) readonly  buffer PAST {float data_p[];};
layout (binding = 1) readonly  buffer W    {float data_w[];};
layout (binding = 2) readonly  buffer DYN  {float data_dyn[];};
layout (binding = 3) readonly  buffer CUR  {float data_c[];};
layout (binding = 4)           buffer ST   {float data_st[];};
layout (binding = 5) readonly  buffer RES  {float data_r[];};
layout (binding = 6) writeonly buffer D    {float data_d[];};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

float xv(uint c, uint s, uint i) {
    return i < p.K - 1 ? data_p[c*p.p_nb1 + s*p.p_nb2 + i] : data_c[(s*p.n_t + i - (p.K - 1))*p.C + c];
}

void main() {
    const uint c  = gl_GlobalInvocationID.x;
    const uint tg = gl_WorkGroupID.y + gl_WorkGroupID.z*65535;
    if (c >= p.C || tg >= p.n_t*p.n_s) {
        return;
    }
    const uint s = tg/p.n_t;
    const uint t = tg%p.n_t;

    float acc = xv(c, s, t + p.K - 1);
    for (uint k = 0; k < p.K; ++k) {
        acc += data_w[c*p.K + k]*xv(c, s, t + k);
    }
    if (p.H != 0) {
        const uint h  = c/(p.C/p.H);
        const uint db = tg*p.K*p.H + h*p.K;
        for (uint lag = 0; lag < p.K; ++lag) {
            acc += data_dyn[db + lag]*xv(c, s, t + p.K - 1 - lag);
        }
    }
    const uint o = tg*p.C + c;
    float out_v = acc*p.out_scale;
    if (p.has_resid != 0u) {
        out_v += data_r[o];
    }
    data_d[o] = out_v;

    if (p.has_state != 0u && t + 1u == p.n_t) {
        const uint n_slots = max(1u, p.n_rs_slots);
        for (uint slot = 0u; slot < n_slots; ++slot) {
            const uint s_idx = p.n_t > slot ? p.n_t - slot : 0u;
            const uint sb = slot * p.s_slot_stride + s * p.s_row + c * (p.K - 1u);
            for (uint i = 0u; i < p.K - 1u; ++i) {
                data_st[sb + i] = xv(c, s, s_idx + i);
            }
        }
    }
}
