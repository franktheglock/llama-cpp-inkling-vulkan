+    LFM2_FUSE_NONE = 0,
+    LFM2_FUSE_ELIDE,     // node is computed by another node's kernel
+    LFM2_FUSE_CONV,      // shortconv: MUL + GET_ROWS + CONCAT + CPY + SSM_CONV + MUL
+    LFM2_FUSE_ROUTER,    // RMS_NORM + MUL + MUL_MAT (router logits)
+    LFM2_FUSE_GATEUP,    // MUL_MAT_ID x2 + GLU
+    LFM2_FUSE_DOWN,      // MUL_MAT_ID + MUL + CONT + SUM_ROWS + ADD
