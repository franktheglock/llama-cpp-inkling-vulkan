+// Emit the kernel for one LFM2 fusion group (see ggml_vk_lfm2_analyze).
+static void ggml_vk_lfm2_dispatch(ggml_backend_vk_context * ctx, vk_context& subctx, const struct ggml_cgraph * cgraph, const lfm2_fuse_group & g) {
+    // A group always depends on the stage before it, so synchronize unconditionally.
+    ctx->unsynced_nodes_written.clear();
+    ctx->unsynced_nodes_read.clear();
+    ggml_vk_sync_buffers(ctx, subctx);
+
+    auto sb = [&](const ggml_tensor * t) { return ggml_vk_tensor_subbuffer(ctx, t); };
+
+    switch (g.kind) {
+    case LFM2_FUSE_CONV: {
+        vk_pipeline pipeline = ctx->device->pipeline_lfm2_conv;
+        ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+        const vk_lfm2_conv_push_constants pc = { g.u[0], g.u[1] };
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+            { sb(g.in[0]), sb(g.in[1]), sb(g.in[2]), sb(g.in[3]), sb(g.out[0]), sb(g.out[1]) },
+            pc, { g.u[0], 1, 1 });
+        break;
+    }
+    case LFM2_FUSE_ROUTER: {
+        vk_pipeline pipeline = ctx->device->pipeline_lfm2_router;
+        ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+        const vk_lfm2_router_push_constants pc = { g.u[0], g.u[1], g.f[0], g.u[2] };
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+            { sb(g.in[0]), sb(g.in[1]), sb(g.in[2]), sb(g.out[0]), sb(g.out[1]) },
+            pc, { g.u[1], 1, 1 });
+        break;
+    }
+    case LFM2_FUSE_GATEUP: {
+        vk_pipeline pipeline = ctx->device->pipeline_lfm2_gateup[g.u[4]][g.u[5]];
+        ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+        const vk_lfm2_moe_push_constants pc = { g.u[0], g.u[1], g.u[1] * (g.u[0] / 256), g.u[2], g.u[1] };
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+            { sb(g.in[0]), sb(g.in[1]), sb(g.in[2]), sb(g.in[3]), sb(g.out[0]) },
+            pc, { g.u[1], g.u[2], 1 });
+        break;
+    }
+    case LFM2_FUSE_DOWN: {
+        vk_pipeline pipeline = ctx->device->pipeline_lfm2_down[g.u[4]];
+        ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+        const vk_lfm2_moe_push_constants pc = { g.u[0], g.u[1], g.u[1] * (g.u[0] / 256), g.u[2], g.u[0] };
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+            { sb(g.in[0]), sb(g.in[1]), sb(g.in[2]), sb(g.in[3]), sb(g.in[4]), sb(g.out[0]) },
+            pc, { g.u[1], 1, 1 });
+        break;
+    }
+    case LFM2_FUSE_MMV_ADD: {
+        ctx->lfm2_mmv_dst = g.out[0];
+        ctx->lfm2_mmv_bias = g.in[2];
+        ggml_vk_mul_mat_vec_q_f16(ctx, subctx, cgraph, g.mm_idx);
+        ctx->lfm2_mmv_dst = nullptr;
+        ctx->lfm2_mmv_bias = nullptr;
+        break;
+    }
+    default:
+        GGML_ABORT("unexpected lfm2 fusion kind");
+    }
+
+    for (const ggml_tensor * t : g.out) {
+        ctx->unsynced_nodes_written.push_back(t);
+    }
+    for (const ggml_tensor * t : g.in) {
+        ctx->unsynced_nodes_read.push_back(t);
+    }
+}
