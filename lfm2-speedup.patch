new file mode 100644
index 0000000..35f5708
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_conv.comp
@@ -0,0 +1,47 @@
+#version 450
+
+// Fused LFM2 short-convolution block for single-token decode (per channel c):
+//   bx        = b[c] * x[c]                                  (b, c, x are the three chunks of in_proj)
+//   y[c]      = cgate[c] * (s0*k[0] + s1*k[1] + bx*k[2])     (s0, s1: recurrent conv state)
+//   state'[c] = (s1, bx)
+// Replaces MUL + GET_ROWS + CONCAT + CPY + SSM_CONV + MUL.
+
+layout (push_constant) uniform parameter
+{
+    uint n;          // channels
+    uint rs_stride;  // elements per recurrent-state row
+} p;
+
+layout (binding = 0) readonly buffer BCX  {float data_bcx[];};
+layout (binding = 1) readonly buffer SIN  {float data_sin[];};
+layout (binding = 2) readonly buffer KERN {float data_k[];};
+layout (binding = 3) readonly buffer IDS  {int data_ids[];};
+layout (binding = 4) writeonly buffer Y    {float data_y[];};
+layout (binding = 5) writeonly buffer SOUT {float data_sout[];};
+
+layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint c = gl_GlobalInvocationID.x;
+    if (c >= p.n) {
+        return;
+    }
+
+    const uint srow = uint(data_ids[0]) * p.rs_stride;
+
+    const float b  = data_bcx[c];
+    const float cg = data_bcx[p.n + c];
+    const float x  = data_bcx[2 * p.n + c];
+    const float bx = b * x;
+
+    const float s0 = data_sin[srow + 2 * c];
+    const float s1 = data_sin[srow + 2 * c + 1];
+
+    float sum = s0 * data_k[3 * c];
+    sum += s1 * data_k[3 * c + 1];
+    sum += bx * data_k[3 * c + 2];
+
+    data_y[c] = cg * sum;
+    data_sout[2 * c]     = s1;
+    data_sout[2 * c + 1] = bx;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_kq_dot.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_kq_dot.glsl
new file mode 100644
index 0000000..eb9e646
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_kq_dot.glsl
@@ -0,0 +1,102 @@
+// K-quant (Q4_K / Q5_K) partial dot product for one 256-weight block, written as a
+// template so one shader can instantiate it against several weight buffers.
+//
+// The includer defines, before each #include:
+//   KQ_NAME   - name of the generated function
+//   KQ_A      - block array (gives .dm)
+//   KQ_A16    - the same buffer viewed as the packed16 struct
+//   KQ_A32    - the same buffer viewed as the packed32 struct (Q4_K only)
+//   KQ_Q5     - define for Q5_K, leave undefined for Q4_K
+// and, once per shader, the activation accessors LFM2_X4(i) / LFM2_X2(i), which
+// return the vec4 / vec2 starting at float index i (i divisible by 4 / 2).
+//
+// 16 threads cooperate on one block; itid (0..15) selects the 16 weights this
+// thread owns. The mapping is the same as mul_mat_vec_q4_k.comp / mul_mat_vec_q5_k.comp.
+
+float KQ_NAME(const uint ib, const uint xbase, const uint itid) {
+    const uint il = itid / 4;       // 0...3
+    const uint ir = itid - 4 * il;  // 0...3
+    const uint v_im = il / 2;       // 0 computes 0,32 + 128,160; 1 computes 64,96 + 192,224
+    const uint v_in = il % 2;
+
+#ifdef KQ_Q5
+    const uint l0 = 4 * ir + 2 * v_in;    // 0...15
+#else
+    const uint l0 = 4 * (2 * ir + v_in);  // 0...28
+#endif
+    const uint q_offset = 32 * v_im + l0;
+    const uint y1_idx = xbase + 64 * v_im + l0;
+    const uint y2_idx = y1_idx + 128;
+
+    const vec2 dm = vec2(KQ_A[ib].dm);
+
+    const uint32_t scale0_u32 = KQ_A16[ib].scales[v_im    ];
+    const uint32_t scale4_u32 = KQ_A16[ib].scales[v_im + 2];
+    const uint32_t scale8_u32 = KQ_A16[ib].scales[v_im + 4];
+
+    const uint32_t scale_0_4_l = (scale4_u32 << 16) | scale0_u32;
+    const uint32_t scale_0_4_h = (scale_0_4_l & 0xC0C0C0C0) >> 2;
+    const vec4 scale_0_4_l_f = vec4(unpack8(scale_0_4_l & 0x3F3F3F3F));
+    const vec4 scale8_f = vec4(unpack8((((scale8_u32 << 12) | scale8_u32) & 0x0F0F0F0F) | scale_0_4_h));
+
+    const float sc0 = scale_0_4_l_f.x;
+    const float sc1 = scale_0_4_l_f.y;
+    const float sc2 = scale_0_4_l_f.z;
+    const float sc3 = scale_0_4_l_f.w;
+    const float sc4 = scale8_f.x;
+    const float sc5 = scale8_f.y;
+    const float sc6 = scale8_f.z;
+    const float sc7 = scale8_f.w;
+
+#ifdef KQ_Q5
+    const uint32_t qs0_u32  = uint32_t(KQ_A16[ib].qs[q_offset / 2])      | (uint32_t(KQ_A16[ib].qs[q_offset / 2 +  8]) << 16);
+    const uint32_t qs64_u32 = uint32_t(KQ_A16[ib].qs[q_offset / 2 + 32]) | (uint32_t(KQ_A16[ib].qs[q_offset / 2 + 40]) << 16);
+
+    const uint32_t qh = pack32(u16vec2(KQ_A16[ib].qh[l0 / 2], KQ_A16[ib].qh[l0 / 2 + 8]));
+
+    const uint32_t qs0_lo4  = (qs0_u32 & 0x0F0F0F0F)         + (((qh >> (2 * v_im)) & 0x01010101) << 4);
+    const uint32_t qs0_hi4  = ((qs0_u32 >> 4) & 0x0F0F0F0F)  + (((qh >> (2 * v_im)) & 0x02020202) << 3);
+    const uint32_t qs64_lo4 = (qs64_u32 & 0x0F0F0F0F)        +  ((qh >> (2 * v_im)) & 0x10101010);
+    const uint32_t qs64_hi4 = ((qs64_u32 >> 4) & 0x0F0F0F0F) + (((qh >> (2 * v_im)) & 0x20202020) >> 1);
+
+    const vec2 a0 = LFM2_X2(y1_idx);
+    const vec2 a1 = LFM2_X2(y1_idx + 16);
+    const vec2 a2 = LFM2_X2(y1_idx + 32);
+    const vec2 a3 = LFM2_X2(y1_idx + 48);
+    const vec2 b0 = LFM2_X2(y2_idx);
+    const vec2 b1 = LFM2_X2(y2_idx + 16);
+    const vec2 b2 = LFM2_X2(y2_idx + 32);
+    const vec2 b3 = LFM2_X2(y2_idx + 48);
+
+    const vec4 by10  = vec4(a0, a1);
+    const vec4 by132 = vec4(a2, a3);
+    const vec4 by20  = vec4(b0, b1);
+    const vec4 by232 = vec4(b2, b3);
+#else
+    const uint32_t qs0_u32  = KQ_A32[ib].qs[q_offset / 4];
+    const uint32_t qs64_u32 = KQ_A32[ib].qs[q_offset / 4 + 16];
+
+    const uint32_t qs0_lo4  = qs0_u32 & 0x0F0F0F0F;
+    const uint32_t qs0_hi4  = (qs0_u32 >> 4) & 0x0F0F0F0F;
+    const uint32_t qs64_lo4 = qs64_u32 & 0x0F0F0F0F;
+    const uint32_t qs64_hi4 = (qs64_u32 >> 4) & 0x0F0F0F0F;
+
+    const vec4 by10  = LFM2_X4(y1_idx);
+    const vec4 by132 = LFM2_X4(y1_idx + 32);
+    const vec4 by20  = LFM2_X4(y2_idx);
+    const vec4 by232 = LFM2_X4(y2_idx + 32);
+#endif
+
+    const float sx = dot(by10,  vec4(unpack8(qs0_lo4)));
+    const float sy = dot(by132, vec4(unpack8(qs0_hi4)));
+    const float sz = dot(by20,  vec4(unpack8(qs64_lo4)));
+    const float sw = dot(by232, vec4(unpack8(qs64_hi4)));
+
+    const float smin =
+        fma(by10.x + by10.y + by10.z + by10.w,     sc2,
+        fma(by132.x + by132.y + by132.z + by132.w, sc3,
+        fma(by20.x + by20.y + by20.z + by20.w,     sc6,
+           (by232.x + by232.y + by232.z + by232.w) * sc7)));
+
+    return fma(dm.x, fma(sx, sc0, fma(sy, sc1, fma(sz, sc4, sw * sc5))), -dm.y * smin);
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_moe_down.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_moe_down.comp
new file mode 100644
index 0000000..28311ee
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_moe_down.comp
@@ -0,0 +1,101 @@
+#version 450
+
+// Fused MoE down projection for single-token decode:
+//   d[r] = resid[r] + sum_e w[e] * dot(down[ids[e]][r], h[e])
+// Replaces MUL_MAT_ID + MUL (expert weights) + CONT + SUM_ROWS + ADD (residual).
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint ncols;            // K, a multiple of 256
+    uint nrows;
+    uint blocks_per_expert;
+    uint n_used;
+    uint x_stride;         // input elements per expert slot
+} p;
+
+#ifdef DOWN_Q5
+#define DOWN_T   block_q5_K
+#define DOWN_T16 block_q5_K_packed16
+#define DOWN_T32 block_q5_K_packed32
+#else
+#define DOWN_T   block_q4_K
+#define DOWN_T16 block_q4_K_packed16
+#define DOWN_T32 block_q4_K_packed32
+#endif
+
+layout (binding = 0) readonly buffer A   {DOWN_T   data_a[];};
+layout (binding = 0) readonly buffer A16 {DOWN_T16 data_a16[];};
+layout (binding = 0) readonly buffer A32 {DOWN_T32 data_a32[];};
+layout (binding = 1) readonly buffer X   {float data_x[];};
+layout (binding = 1) readonly buffer XV2 {vec2 data_x_v2[];};
+layout (binding = 1) readonly buffer XV4 {vec4 data_x_v4[];};
+layout (binding = 2) readonly buffer IDS {int data_ids[];};
+layout (binding = 3) readonly buffer W   {float data_w[];};
+layout (binding = 4) readonly buffer R   {float data_r[];};
+layout (binding = 5) writeonly buffer D  {float data_d[];};
+
+#define LFM2_X4(i) data_x_v4[(i) / 4]
+#define LFM2_X2(i) data_x_v2[(i) / 2]
+
+#define KQ_NAME dot_down
+#define KQ_A    data_a
+#define KQ_A16  data_a16
+#define KQ_A32  data_a32
+#ifdef DOWN_Q5
+#define KQ_Q5
+#endif
+#include "lfm2_kq_dot.glsl"
+
+layout (local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+layout (constant_id = 0) const uint BLOCK_SIZE = 32;
+layout (constant_id = 1) const uint NUM_ROWS = 2;
+
+void main() {
+    const uint first_row = NUM_ROWS * gl_WorkGroupID.x;
+    const uint nb = p.ncols / 256;
+
+    const uint tid = gl_LocalInvocationID.x;
+    const uint itid = tid % 16;
+    const uint ix = tid / 16;
+    const uint it_size = gl_WorkGroupSize.x / 16;
+
+    float acc[NUM_ROWS];
+    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+        acc[n] = 0.0;
+    }
+
+    for (uint e = 0; e < p.n_used; ++e) {
+        const uint expert = uint(data_ids[e]);
+        const float w = data_w[e];
+        const uint xbase = e * p.x_stride;
+        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+            const uint row = min(first_row + n, p.nrows - 1);
+            const uint ib0 = expert * p.blocks_per_expert + row * nb;
+            float t = 0.0;
+            for (uint i = ix; i < nb; i += it_size) {
+                t += dot_down(ib0 + i, xbase + i * 256, itid);
+            }
+            acc[n] = fma(w, t, acc[n]);
+        }
+    }
+
+    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+        acc[n] = subgroupAdd(acc[n]);
+    }
+
+    if (tid == 0) {
+        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+            const uint row = first_row + n;
+            if (row < p.nrows) {
+                data_d[row] = data_r[row] + acc[n];
+            }
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_moe_gateup.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_moe_gateup.comp
new file mode 100644
index 0000000..e3acf1a
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_moe_gateup.comp
@@ -0,0 +1,128 @@
+#version 450
+
+// Fused MoE gate + up projection + SwiGLU for single-token decode:
+//   d[e][r] = silu(dot(gate[ids[e]][r], x)) * dot(up[ids[e]][r], x)
+// Replaces two MUL_MAT_ID dispatches and the GLU dispatch that joins them.
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint ncols;            // K, a multiple of 256
+    uint nrows;            // rows per expert
+    uint blocks_per_expert;
+    uint n_used;
+    uint d_stride;         // output elements per expert slot
+} p;
+
+#ifdef GATE_Q5
+#define GATE_T   block_q5_K
+#define GATE_T16 block_q5_K_packed16
+#define GATE_T32 block_q5_K_packed32
+#else
+#define GATE_T   block_q4_K
+#define GATE_T16 block_q4_K_packed16
+#define GATE_T32 block_q4_K_packed32
+#endif
+
+#ifdef UP_Q5
+#define UP_T   block_q5_K
+#define UP_T16 block_q5_K_packed16
+#define UP_T32 block_q5_K_packed32
+#else
+#define UP_T   block_q4_K
+#define UP_T16 block_q4_K_packed16
+#define UP_T32 block_q4_K_packed32
+#endif
+
+layout (binding = 0) readonly buffer G   {GATE_T   data_g[];};
+layout (binding = 0) readonly buffer G16 {GATE_T16 data_g16[];};
+layout (binding = 0) readonly buffer G32 {GATE_T32 data_g32[];};
+layout (binding = 1) readonly buffer U   {UP_T   data_u[];};
+layout (binding = 1) readonly buffer U16 {UP_T16 data_u16[];};
+layout (binding = 1) readonly buffer U32 {UP_T32 data_u32[];};
+layout (binding = 2) readonly buffer X   {float data_x[];};
+layout (binding = 2) readonly buffer XV2 {vec2 data_x_v2[];};
+layout (binding = 2) readonly buffer XV4 {vec4 data_x_v4[];};
+layout (binding = 3) readonly buffer IDS {int data_ids[];};
+layout (binding = 4) writeonly buffer D  {float data_d[];};
+
+#define LFM2_X4(i) data_x_v4[(i) / 4]
+#define LFM2_X2(i) data_x_v2[(i) / 2]
+
+#define KQ_NAME dot_gate
+#define KQ_A    data_g
+#define KQ_A16  data_g16
+#define KQ_A32  data_g32
+#ifdef GATE_Q5
+#define KQ_Q5
+#endif
+#include "lfm2_kq_dot.glsl"
+#undef KQ_NAME
+#undef KQ_A
+#undef KQ_A16
+#undef KQ_A32
+#undef KQ_Q5
+
+#define KQ_NAME dot_up
+#define KQ_A    data_u
+#define KQ_A16  data_u16
+#define KQ_A32  data_u32
+#ifdef UP_Q5
+#define KQ_Q5
+#endif
+#include "lfm2_kq_dot.glsl"
+#undef KQ_NAME
+#undef KQ_A
+#undef KQ_A16
+#undef KQ_A32
+#undef KQ_Q5
+
+layout (local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+layout (constant_id = 0) const uint BLOCK_SIZE = 32;
+layout (constant_id = 1) const uint NUM_ROWS = 2;
+
+void main() {
+    const uint slot = gl_WorkGroupID.y;
+    const uint expert = uint(data_ids[slot]);
+    const uint first_row = NUM_ROWS * gl_WorkGroupID.x;
+    const uint nb = p.ncols / 256;
+
+    const uint tid = gl_LocalInvocationID.x;
+    const uint itid = tid % 16;
+    const uint ix = tid / 16;
+    const uint it_size = gl_WorkGroupSize.x / 16;
+
+    float tg[NUM_ROWS];
+    float tu[NUM_ROWS];
+
+    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+        tg[n] = 0.0;
+        tu[n] = 0.0;
+        const uint row = min(first_row + n, p.nrows - 1);
+        const uint ib0 = expert * p.blocks_per_expert + row * nb;
+        for (uint i = ix; i < nb; i += it_size) {
+            tg[n] += dot_gate(ib0 + i, i * 256, itid);
+            tu[n] += dot_up(ib0 + i, i * 256, itid);
+        }
+    }
+
+    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+        tg[n] = subgroupAdd(tg[n]);
+        tu[n] = subgroupAdd(tu[n]);
+    }
+
+    if (tid == 0) {
+        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+            const uint row = first_row + n;
+            if (row < p.nrows) {
+                data_d[slot * p.d_stride + row] = tg[n] / (1.0 + exp(-tg[n])) * tu[n];
+            }
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_router.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_router.comp
new file mode 100644
index 0000000..f99d59d
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lfm2_router.comp
@@ -0,0 +1,57 @@
+#version 450
+
+// Fused MoE router front end for single-token decode. One workgroup per expert e:
+//   scale     = 1 / sqrt(mean(h^2) + eps)
+//   logits[e] = dot(W[e], h * g) * scale
+// and the workgroups together write xn = h * g * scale for the expert mat-vecs.
+// Replaces RMS_NORM + MUL + MUL_MAT (the top-k chain that follows is unchanged).
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+layout (push_constant) uniform parameter
+{
+    uint n;          // embedding size, a multiple of 4
+    uint n_expert;
+    float eps;
+    uint xn_chunk;   // xn elements written per workgroup, a multiple of 4
+} p;
+
+layout (binding = 0) readonly buffer H    {vec4 data_h[];};
+layout (binding = 1) readonly buffer G    {vec4 data_g[];};
+layout (binding = 2) readonly buffer W    {vec4 data_w[];};
+layout (binding = 3) writeonly buffer XN  {vec4 data_xn[];};
+layout (binding = 4) writeonly buffer LG  {float data_logits[];};
+
+layout (local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+layout (constant_id = 0) const uint BLOCK_SIZE = 32;
+
+void main() {
+    const uint e = gl_WorkGroupID.x;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint n4 = p.n / 4;
+    const uint wbase = e * n4;
+
+    float ss = 0.0;
+    float acc = 0.0;
+    for (uint i = tid; i < n4; i += BLOCK_SIZE) {
+        const vec4 h = data_h[i];
+        ss += dot(h, h);
+        acc += dot(data_w[wbase + i], h * data_g[i]);
+    }
+    ss = subgroupAdd(ss);
+    acc = subgroupAdd(acc);
+
+    const float scale = inversesqrt(ss / float(p.n) + p.eps);
+
+    if (tid == 0) {
+        data_logits[e] = acc * scale;
+    }
+
+    const uint c4 = p.xn_chunk / 4;
+    for (uint i = e * c4 + tid; i < min((e + 1) * c4, n4); i += BLOCK_SIZE) {
+        data_xn[i] = data_h[i] * data_g[i] * scale;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
